    "annotations": {
      "destructiveHint": false,
      "openWorldHint": true,
      "readOnlyHint": true,
      "title": "Get Latest Date"
    },
    "description": "Get the most recent available date for a CFR title.\n\n    CRITICAL: eCFR lags 1-2 business days behind the Federal Register.\n    Using today's date on versioner endpoints causes 404 errors. Call this\n    first to get the safe date, then pass it to other tools.\n\n    Default title 48 = Federal Acquisition Regulations System (FAR, DFARS,\n    and all agency supplements). Other common titles: 2 (Grants/Agreements),\n    5 (Administrative Personnel), 29 (Labor), 41 (Public Contracts).\n\n    Raises ValueError for titles 1-50 that are reserved (no content).\n    ",
    "inputSchema": {
      "properties": {
        "title_number": {
          "default": 48,
          "title": "Title Number",
          "type": "integer"
        }
      },
      "type": "object",
      "title": "get_latest_dateArguments"
    },
    "name": "get_latest_date",
    "outputSchema": {
      "type": "object",
      "additionalProperties": true,
      "title": "get_latest_dateDictOutput"
    }
  },
  {
    "annotations": {
      "destructiveHint": false,
      "openWorldHint": true,
      "readOnlyHint": true,
      "title": "Get CFR Content"
    },
    "description": "Get the full text of a CFR section, subpart, part, or appendix.\n\n    This is the primary workhorse for reading regulatory text. Returns\n    parsed clean text by default (heading, paragraphs, citations, plus\n    tables and editorial_notes when present). Set raw_xml=True to get the\n    original XML instead.\n\n    Specify the narrowest scope possible to keep responses manageable:\n    - section='15.305' for a single FAR section\n    - subpart='15.3' for a subpart\n    - part='15' for an entire part (can be large)\n    - chapter='1' for an entire chapter (often >1 MB, avoid)\n    - appendix='Appendix A to Chapter 2' (with chapter='2') for a DFARS appendix\n\n    Date auto-resolves to the latest available if not provided. Do NOT use\n    today's date directly -- eCFR lags 1-2 business days and today often 404s.\n\n    Title 48 = FAR/DFARS. Chapter 1 = FAR (Parts 1-99), Chapter 2 = DFARS\n    (Parts 200-299). Other chapters = agency FAR supplements (GSAR, VAAR,\n    HSAR, etc.).\n\n    For DFARS clauses, use chapter='2' (e.g., section='252.227-7014').\n\n    part/subpart/section accept int or string. Common prefix mistakes like\n    section='FAR 15.305' or '48 CFR 15.305' are stripped automatically, and\n    trailing paragraph cites like section='15.305(a)(2)' resolve to the base\n    section '15.305'.\n    ",
    "inputSchema": {
      "properties": {
        "title_number": {
          "default": 48,
          "title": "Title Number",
          "type": "integer"
        },
        "date": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Date"
        },
        "part": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Part"
        },
        "subpart": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Subpart"
        },
        "section": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Section"
        },
        "chapter": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Chapter"
        },
        "appendix": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Appendix"
        },
        "raw_xml": {
          "default": false,
          "title": "Raw Xml",
          "type": "boolean"
        }
      },
      "type": "object",
      "title": "get_cfr_contentArguments"
    },
    "name": "get_cfr_content",
    "outputSchema": {
      "type": "object",
      "additionalProperties": true,
      "title": "get_cfr_contentDictOutput"
    }
