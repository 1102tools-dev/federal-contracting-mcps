  {
    "annotations": {
      "destructiveHint": false,
      "readOnlyHint": true,
      "title": "Search Documents"
    },
    "description": "Search Regulations.gov documents (proposed rules, final rules, notices).\n\n    Filter values are CASE-SENSITIVE. Use exact casing:\n    - document_type: 'Proposed Rule', 'Rule', 'Notice', 'Supporting & Related Material', 'Other'\n    - Lowercase values silently return 0 results (no error)\n\n    Key parameters:\n    - agency_id: FAR, DARS, GSA, SBA, OFPP, DOD, NASA, VA, etc.\n      Comma-separate for multiple agencies ('FAR,GSA').\n      Empty string is REJECTED (previously returned all 1.95M records).\n    - docket_id: e.g., 'FAR-2023-0008' for a specific FAR case\n    - within_comment_period: True to find documents currently accepting\n      comments. False is NOT supported by the API (it 400s); omit the\n      parameter instead to search regardless of comment status.\n    - posted_date_ge/le: YYYY-MM-DD format (calendar-checked)\n    - comment_end_date_ge/le: YYYY-MM-DD format\n\n    Response includes meta.aggregations with counts by document type, agency,\n    and comment period status.\n\n    Page size: 5-250. page_number: 1-40 (10,000 reachable records per\n    query; the live API allows 40 pages even though the docs say 20).\n    For larger sets, partition with date ranges, or use the API's deep\n    pagination recipe: sort='lastModifiedDate,documentId' plus\n    lastModifiedDate windows on search_dockets/search_comments.\n\n    sort: '-postedDate' (newest first, default), 'postedDate', '-commentEndDate',\n    'lastModifiedDate', 'title', 'documentId'. Comma-separate for\n    multi-field sorts ('lastModifiedDate,documentId').\n    ",
    "inputSchema": {
      "properties": {
        "agency_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Agency Id"
        },
        "comment_end_date_ge": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Comment End Date Ge"
        },
        "comment_end_date_le": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Comment End Date Le"
        },
        "docket_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Docket Id"
        },
        "document_type": {
          "anyOf": [
            {
              "enum": [
                "Proposed Rule",
                "Rule",
                "Notice",
                "Supporting & Related Material",
                "Other"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Document Type"
        },
        "page_number": {
          "default": 1,
          "title": "Page Number",
          "type": "integer"
        },
        "page_size": {
          "default": 25,
          "title": "Page Size",
          "type": "integer"
        },
        "posted_date_ge": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Posted Date Ge"
        },
        "posted_date_le": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Posted Date Le"
        },
        "search_term": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Search Term"
        },
        "sort": {
          "default": "-postedDate",
          "title": "Sort",
          "type": "string"
