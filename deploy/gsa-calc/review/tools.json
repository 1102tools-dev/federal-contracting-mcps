      "title": "Suggest Contains"
    },
    "description": "Discover exact field values via autocomplete/contains matching.\n\n    Returns aggregation buckets showing matching values and their record\n    counts. Use this BEFORE exact_search() to find the right value string.\n\n    Minimum 2 characters required for the search term.\n\n    Example workflow:\n    1. suggest_contains('vendor_name', 'booz') -> finds 'Booz Allen Hamilton Inc.'\n    2. exact_search('vendor_name', 'Booz Allen Hamilton Inc.') -> all their rates\n    ",
    "inputSchema": {
      "properties": {
        "field": {
          "enum": [
            "labor_category",
            "vendor_name",
            "idv_piid"
          ],
          "title": "Field",
          "type": "string"
        },
        "term": {
          "title": "Term",
          "type": "string"
        }
      },
      "required": [
        "field",
        "term"
      ],
      "type": "object",
      "title": "suggest_containsArguments"
    },
    "name": "suggest_contains",
    "outputSchema": {
      "type": "object",
      "additionalProperties": true,
      "title": "suggest_containsDictOutput"
    }
  },
