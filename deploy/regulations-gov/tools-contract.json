  {
    "annotations": {
      "destructiveHint": false,
      "readOnlyHint": true,
      "title": "Open Comment Periods"
    },
    "description": "Find documents with currently open comment periods.\n\n    Searches for documents where withinCommentPeriod=true, sorted by\n    soonest closing deadline (ascending commentEndDate, so even when the\n    result set is truncated it keeps the deadlines you can still act on).\n    Returns document IDs, titles, agencies, comment end dates, docket IDs,\n    the API-true total_open, and a truncated flag when more exist than the\n    250 returned.\n\n    Default searches FAR, DARS, GSA, SBA, OFPP, DOD, NASA, VA in a single\n    comma-joined query. Pass agency_ids to narrow or expand the scope. An\n    empty list is rejected; pass None to use the defaults.\n    ",
    "inputSchema": {
      "properties": {
        "agency_ids": {
          "anyOf": [
            {
              "items": {
                "type": "string"
              },
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Agency Ids"
        }
      },
      "title": "open_comment_periodsArguments",
      "type": "object"
    },
    "name": "open_comment_periods",
    "outputSchema": {
      "additionalProperties": true,
      "title": "open_comment_periodsDictOutput",
      "type": "object"
    }
  },
  {
    "annotations": {
      "destructiveHint": false,
      "readOnlyHint": true,
      "title": "Search Comments"
    },
    "description": "Search public comments on Regulations.gov.\n\n    To find comments on a specific document, use comment_on_id with the\n    hex objectId from document detail/search results (attributes.objectId,\n    e.g. '0900006486531e6b'). The human-readable documentId is REJECTED\n    here because the API silently returns 0 comments for it.\n\n    docket_id can also filter comments to all documents in a docket\n    (undocumented upstream but verified working live).\n\n    Page size: 5-250. Comments sorted by '-postedDate' by default.\n    ",
    "inputSchema": {
      "properties": {
        "agency_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Agency Id"
        },
        "comment_on_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Comment On Id"
        },
        "docket_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Docket Id"
        },
        "page_number": {
          "default": 1,
          "title": "Page Number",
          "type": "integer"
        },
        "page_size": {
          "default": 25,
          "title": "Page Size",
          "type": "integer"
        },
        "posted_date_ge": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Posted Date Ge"
        },
        "posted_date_le": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Posted Date Le"
        },
        "search_term": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Search Term"
        },
        "sort": {
          "default": "-postedDate",
          "title": "Sort",
          "type": "string"
        }
      },
      "title": "search_commentsArguments",
      "type": "object"
    },
    "name": "search_comments",
    "outputSchema": {
      "additionalProperties": true,
      "title": "search_commentsDictOutput",
      "type": "object"
    }
