            }
          ],
          "default": null,
          "title": "Agency Id"
        },
        "docket_type": {
          "anyOf": [
            {
              "enum": [
                "Rulemaking",
                "Nonrulemaking"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Docket Type"
        },
        "last_modified_date_ge": {
