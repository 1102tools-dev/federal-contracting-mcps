{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "sam-gov-mcp",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-07",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "account_id": "846d3e41e48446abcd3570c0959f9fb5",
  "workers_dev": true,
  // Worker only, no container: tools query D1 directly. The nightly loader
  // is scheduled separately for opportunities and public entities/exclusions.
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "sam-gov-opportunities",
      "database_id": "8875076f-cbb2-4ce8-9ea1-b152323fbbb0"
    },
    {
      "binding": "ENTITY_DB",
      "database_name": "sam-gov-entities",
      "database_id": "18a226be-201f-46de-99b9-db65dd5edea7"
    },
    {
      "binding": "NAME_INDEX_DB",
      "database_name": "sam-gov-name-index",
      "database_id": "4ed19059-3fc7-433d-aafe-ab4c1f3ee31f"
    }
  ],
  "durable_objects": {
    "bindings": [
      {
        "class_name": "RateCounter",
        "name": "RATE_COUNTER"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": [
        "RateCounter"
      ]
    }
  ],
  "ratelimits": [
    {
      "name": "REQUEST_LIMITER",
      "namespace_id": "110267",
      "simple": {
        "limit": 120,
        "period": 60
      }
    },
    {
      "name": "AI_LIMITER",
      "namespace_id": "110278",
      "simple": {
        "limit": 600,
        "period": 60
      }
    }
  ],
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true,
      "invocation_logs": false
    }
  },
  "env": {
    "production": {
      "name": "sam-gov-mcp",
      "routes": [
        {
          "pattern": "sam.1102tools.com",
          "custom_domain": true
        }
      ],
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "sam-gov-opportunities",
          "database_id": "8875076f-cbb2-4ce8-9ea1-b152323fbbb0"
        },
        {
          "binding": "ENTITY_DB",
          "database_name": "sam-gov-entities",
          "database_id": "18a226be-201f-46de-99b9-db65dd5edea7"
        },
        {
          "binding": "NAME_INDEX_DB",
          "database_name": "sam-gov-name-index",
          "database_id": "4ed19059-3fc7-433d-aafe-ab4c1f3ee31f"
        }
      ],
      "durable_objects": {
        "bindings": [
          {
            "class_name": "RateCounter",
            "name": "RATE_COUNTER"
          }
        ]
      },
      "ratelimits": [
        {
          "name": "REQUEST_LIMITER",
          "namespace_id": "110267",
          "simple": {
            "limit": 120,
            "period": 60
          }
        },
        {
          "name": "AI_LIMITER",
          "namespace_id": "110278",
          "simple": {
            "limit": 600,
            "period": 60
          }
        }
      ]
    }
  }
}
