  {
    "annotations": {
      "destructiveHint": false,
      "openWorldHint": true,
      "readOnlyHint": true,
      "title": "Keyword Search"
    },
    "description": "Search GSA CALC+ ceiling rates by keyword.\n\n    Performs wildcard matching across labor_category, vendor_name, and\n    idv_piid fields. This is the primary search tool for finding rates.\n\n    Returns matching rate records plus aggregation statistics (wage_stats,\n    percentiles, education breakdown, business size) covering the FULL\n    result set even when individual hits are capped at 10,000.\n\n    Important notes:\n    - These are NTE (not-to-exceed) ceiling rates, not prices paid\n    - Rates are fully burdened hourly rates from GSA MAS contracts\n    - Data refreshes nightly from vendor price proposal tables\n    - Use P50 from percentiles for median (more accurate than median_price)\n\n    Filter parameters:\n    - education_level: AA, BA, HS, MA, PHD, TEC (pipe-delimited for OR: 'BA|MA')\n    - experience_min/max: years of experience range\n    - price_min/max: hourly rate range in USD\n    - business_size: 'S' (small) or 'O' (other/large)\n    - security_clearance: 'yes' or 'no'\n    - sin: Special Item Number (e.g., '54151S' for IT Professional Services)\n    - worksite: NOT supported (the v3 API silently ignores it; passing a\n      value raises so callers are not handed unfiltered data)\n\n    ordering: current_price, labor_category, vendor_name, education_level,\n    min_years_experience, next_year_price, idv_piid, business_size.\n    sort: 'asc' or 'desc'.\n\n    exclude: pipe-delimited hit _id values to exclude from results and stats.\n    ",
    "inputSchema": {
      "properties": {
        "keyword": {
          "title": "Keyword",
          "type": "string"
        },
        "education_level": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Education Level"
        },
        "experience_min": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Experience Min"
        },
        "experience_max": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Experience Max"
        },
        "price_min": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Price Min"
        },
        "price_max": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Price Max"
        },
        "business_size": {
          "anyOf": [
            {
              "enum": [
                "S",
                "O"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Business Size"
        },
        "security_clearance": {
          "anyOf": [
            {
              "enum": [
                "yes",
                "no"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Security Clearance"
        },
        "sin": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Sin"
        },
        "worksite": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Worksite"
        },
        "page": {
          "default": 1,
          "title": "Page",
          "type": "integer"
        },
        "page_size": {
          "default": 100,
          "title": "Page Size",
          "type": "integer"
        },
        "ordering": {
          "default": "current_price",
          "title": "Ordering",
          "type": "string"
        },
        "sort": {
          "default": "asc",
          "enum": [
            "asc",
            "desc"
          ],
          "title": "Sort",
          "type": "string"
        },
        "exclude": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Exclude"
        }
      },
      "required": [
        "keyword"
      ],
      "type": "object",
      "title": "keyword_searchArguments"
    },
    "name": "keyword_search",
    "outputSchema": {
      "type": "object",
      "additionalProperties": true,
      "title": "keyword_searchDictOutput"
    }
