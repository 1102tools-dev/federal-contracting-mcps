# Build artifacts (DXT files will live in Releases, not in tree)
*.dxt
dist/
build/

# Python
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
.venv/
venv/
env/

# Node (if DXT tooling requires it)
node_modules/
package-lock.json

# OS
.DS_Store
Thumbs.db

# Editor
.idea/
.vscode/
*.swp
*.swo

# Secrets
.env
.env.local
*.key

# Generated hosted deployment files
deploy/*/node_modules/
deploy/*/worker-configuration.d.ts
deploy/*/wrangler.release.json
!deploy/*/package-lock.json
