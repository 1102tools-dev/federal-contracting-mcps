  {
    "annotations": {
      "destructiveHint": false,
      "openWorldHint": true,
      "readOnlyHint": true,
      "title": "Vendor Rate Card"
    },
    "description": "Get ceiling rates for a specific vendor, one page at a time.\n\n    Auto-discovers the exact vendor name via suggest-contains, then pulls\n    their rate records. Returns labor categories, rates, education levels,\n    experience requirements, SINs, and contract numbers.\n\n    Pass a partial name (e.g., 'booz' for Booz Allen Hamilton). The tool\n    finds the exact registered name automatically.\n\n    Large vendors span many pages: Booz Allen Hamilton carries ~1,900 labor\n    categories. The default page_size is 100 (~23KB) because a 500-row page\n    for a vendor that size is ~114KB and overflows MCP client output limits.\n    Rows are ordered by labor_category ascending by default, so a partial\n    card is alphabet-biased; check has_more and keep calling with next_page\n    until it is false before treating the card as complete.\n\n    There is no server-side way to intersect a vendor with a labor-category\n    keyword (the v3 API ignores vendor_name and labor_category as filter\n    fields; live-verified). To find specific categories, page through the\n    full card and match client-side.\n\n    If the discovery term matches multiple vendors, this tool picks the one\n    with the most rate records and returns a _candidates list so the caller\n    can re-query with a more specific term if needed.\n    ",
    "inputSchema": {
      "properties": {
        "vendor_name": {
          "title": "Vendor Name",
          "type": "string"
        },
        "page": {
          "default": 1,
          "title": "Page",
          "type": "integer"
        },
        "page_size": {
          "default": 100,
          "title": "Page Size",
          "type": "integer"
        },
        "ordering": {
          "default": "labor_category",
          "title": "Ordering",
          "type": "string"
        },
        "sort": {
          "default": "asc",
          "enum": [
            "asc",
            "desc"
          ],
          "title": "Sort",
          "type": "string"
        }
      },
      "required": [
        "vendor_name"
      ],
      "type": "object",
      "title": "vendor_rate_cardArguments"
    },
    "name": "vendor_rate_card",
    "outputSchema": {
      "type": "object",
      "additionalProperties": true,
      "title": "vendor_rate_cardDictOutput"
    }
  },
  {
    "annotations": {
