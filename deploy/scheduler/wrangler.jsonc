{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "1102tools-scheduler",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-07",
  "account_id": "846d3e41e48446abcd3570c0959f9fb5",
  "workers_dev": false,
  "preview_urls": false,
  "routes": [],
  "observability": {
    "enabled": true,
    "logs": {"enabled": true, "invocation_logs": false}
  },
  "env": {
    "production": {
      "name": "1102tools-scheduler",
      "workers_dev": false,
      "preview_urls": false,
      "routes": [],
      "secrets": {"required": ["GITHUB_DISPATCH_TOKEN"]},
      "triggers": {
        "crons": ["15 */2 * * *", "15 */4 * * *", "10 10 * * *", "10 11 * * *", "40 9 * * *", "7,37 * * * *"]
      }
    }
  }
}
