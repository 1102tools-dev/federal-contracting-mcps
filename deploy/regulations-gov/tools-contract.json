  {
    "annotations": {
      "destructiveHint": false,
      "readOnlyHint": true,
      "title": "FAR Case History"
    },
    "description": "Get the full lifecycle of a FAR/DFARS rulemaking case.\n\n    Fetches the docket metadata (title, abstract, RIN) plus the documents\n    filed under the docket, sorted by most recent first. Follows pagination\n    up to 1,000 documents (4 pages); larger dockets set truncated=true\n    (FAR/DARS dockets are far smaller, but the tool accepts any docket).\n\n    docket_id examples: FAR-2023-0008, DARS-2025-0071\n\n    Returns the docket abstract, RIN (links to Unified Agenda), and the\n    documents with their types, dates, and URLs.\n    ",
    "inputSchema": {
      "properties": {
        "docket_id": {
          "title": "Docket Id",
          "type": "string"
        }
      },
      "required": [
        "docket_id"
      ],
      "title": "far_case_historyArguments",
      "type": "object"
    },
    "name": "far_case_history",
    "outputSchema": {
      "additionalProperties": true,
      "title": "far_case_historyDictOutput",
      "type": "object"
    }
  },
