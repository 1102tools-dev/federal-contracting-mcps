            }
          ],
          "default": null,
          "title": "Last Modified Date Ge"
        },
        "last_modified_date_le": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Last Modified Date Le"
        },
        "page_number": {
          "default": 1,
          "title": "Page Number",
          "type": "integer"
        },
        "page_size": {
          "default": 25,
          "title": "Page Size",
          "type": "integer"
        },
        "search_term": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Search Term"
        },
        "sort": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
